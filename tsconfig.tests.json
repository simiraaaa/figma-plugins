{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "plugin-typings"],
    "typeRoots": ["node_modules/@types", "node_modules/@figma"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": ["tests/**/*.mts"]
}
